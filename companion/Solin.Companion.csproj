<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shaped after cross/Capri.Cross.csproj in lachydotmcg/capri-desktop. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Solin.Companion</AssemblyName>
    <RootNamespace>Solin.Companion</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>0.1.0</Version>
    <Product>Solin</Product>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CA1416;CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
  </ItemGroup>
  <ItemGroup>
    <None Include="LICENSE.md;NOTICE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="assets/sprites/*.png" LogicalName="Solin.Sprite.%(Filename)%(Extension)" />
    <EmbeddedResource Include="assets/portraits/*.png" LogicalName="Solin.Portrait.%(Filename)%(Extension)" />
    <AvaloniaResource Include="assets/fonts/*.ttf" Link="Assets/%(Filename)%(Extension)" />
    <None Include="assets/fonts/*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
